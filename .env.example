# Copy to .env and adjust. Used by docker-compose.yml.

# Default local model the proxy injects when a request omits `model`.
# Pull it first: `ollama pull <model>` (native) or
# `docker compose exec ollama ollama pull <model>` (in-Docker).
#   qwen2.5-coder:7b   (~4.7 GB, comfortable on 16 GB)
#   qwen2.5-coder:14b  (~9 GB, stretch on 16 GB — see README load-test notes)
LAAM_DEFAULT_MODEL=qwen2.5-coder:7b

# Required only for the optional `public` profile (ngrok). Reserved free
# static domain is set in docker-compose.yml.
NGROK_AUTHTOKEN=
