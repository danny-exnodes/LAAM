# Enforce the engines floor (package.json: node>=20, npm>=10.9.0) so a too-old npm
# can't silently produce a divergent lock. NOTE: this does NOT by itself fix the
# Windows(npm11)↔alpine(npm10) musl @emnapi drift — that is platform-based.
# DURABLE RULE: regenerate package-lock.json inside node:22-alpine (the build env),
# NOT on the host, or `npm ci` in the Docker build will fail on missing musl deps.
engine-strict=true
