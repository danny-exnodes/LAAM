{
  "name": "laam-v2",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "LAAM v2 — local-first multi-user (Next.js + Postgres + Auth.js). Dev: npm run dev.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run -c vitest.eval.config.ts scripts/eval/suite.eval.ts",
    "eval:scale": "vitest run -c vitest.eval.config.ts scripts/eval/suite.scale.eval.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@xyflow/react": "12.11.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "pdfjs-dist": "^6.0.227",
    "pg": "8.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "three": "^0.184.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^16.4.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "^29.1.1",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0",
