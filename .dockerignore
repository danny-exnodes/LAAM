# Keep the build context small and the image clean.

# Dependencies are installed inside the image via `npm ci`.
node_modules
**/node_modules

# VCS / tooling metadata
.git
.gitignore
.github

# The proxy is built from its own context (./proxy) with a separate Dockerfile;
# don't ship it inside the LAAM web image.
proxy

# OS / editor cruft
.DS_Store
**/.DS_Store
*.log
*.swp

# Tests and local Claude config aren't needed at runtime.
test
.claude

# Docker / compose files themselves don't belong in the image.
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.yaml

# Misc
*.md
